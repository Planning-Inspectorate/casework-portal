{% extends "views/layouts/main.njk" %}

{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/table/macro.njk" import govukTable %}
{% from "govuk/components/tag/macro.njk" import govukTag %}

{% block pageContent %}
    <ul class="govuk-grid-row pins-card-group">
        {% for link in links %}
            <li class="govuk-grid-column-one-third pins-card-group__item govuk-!-margin-bottom-4">
                <div class="pins-card pins-card--clickable">
                    <div class="pins-card__content">
                        <h2 class="pins-card__heading govuk-header-m">
                            <a href="{{ link.url }}" class="govuk-link govuk-link--no-visited-state">
                                {{ link.title }}
                            </a>
                        </h2>
                        <div class="pins-card__description">
                            <p class="govuk-body">
                                {{ link.description }}
                            </p>
                        </div>
                    </div>
                </div>
            </li>
        {% endfor %}
    </ul>

    <script>
      document.querySelectorAll(".pins-card--clickable").forEach(function(e) {
        null !== e.querySelector("a") && e.addEventListener("click", function() {
          e.querySelector("a").click()
        })
      })
    </script>
{% endblock %}