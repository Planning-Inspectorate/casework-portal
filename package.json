{
  "name": "casework-portal",
  "version": "1.0.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "index.js",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "commitlint": "commitlint --from=$(git rev-parse $(git cherry origin/main | head -n 1 | cut -c 3-)^1)",
    "format": "prettier --write .",
    "format-check": "prettier --check .",
    "lint": "npx eslint .",
    "prepare": "node .husky/install.mjs",
    "test": "node --test",
    "test-coverage": "node --test --experimental-test-coverage"
  },
  "dependencies": {
    "@azure/identity": "^4.14.0",
    "@azure/msal-node": "^7.1.2",
    "@planning-inspectorate/core": "^1.15.0",
    "accessible-autocomplete": "^3.0.2",
    "body-parser": "^2.4.0",
    "connect-redis": "^10.0.0",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "express": "^5.3.0",
    "express-session": "^1.19.0",
    "express-validator": "^7.3.2",
    "govuk-frontend": "^6.6.0",
    "helmet": "^8.3.0",
    "nunjucks": "^3.2.4",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "redis": "^6.3.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.0.2",
    "@eslint/js": "^10.0.1",
    "@microsoft/microsoft-graph-types": "^2.43.1",
    "@planning-inspectorate/coding-standards": "^2.0.0",
    "cookie-parser": "^1.4.7",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.10",
    "prettier-plugin-prisma": "^5.0.0",
    "sass": "^1.106.1"
  },
  "lint-staged": {
    "*.js": [
      "eslint --fix"
    ],
    "*.{js,ts,json,md,prisma,yml,yaml,scss}": [
      "prettier --write"
    ]
  }
}
